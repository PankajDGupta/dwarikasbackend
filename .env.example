# =============================================================================
# .env.example — Dwarikas Backend Local Development Environment Template
#
# Copy this file to .env.local and fill in your local values.
# NEVER commit actual secrets to source control.
#
# In production, all variables marked [SECRET MANAGER] are sourced from
# Google Cloud Secret Manager and injected as env vars into Cloud Run.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-50-char-random-string-for-local-dev   # [SECRET MANAGER] in prod
DEBUG=True                                                              # Must be False in prod
ALLOWED_HOSTS=localhost,127.0.0.1                                       # [SECRET MANAGER] in prod: api.dwarikas.com
DJANGO_SETTINGS_MODULE=dwarikasbackend.settings

# ---------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# Local: use the Supabase local stack (supabase start)
# Production: use the Supabase pooler URI (port 6543)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
SUPABASE_JWT_SECRET=your-local-supabase-jwt-secret                     # [SECRET MANAGER] in prod
# Find it in: supabase status -> JWT secret, or Dashboard -> Settings -> API

# ---------------------------------------------------------------------------
# Redis — Cache, Rate Limiting, JTI Blocklist (Spec #16)
# Leave unset in test runs — tests use LocMemCache automatically.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0                                      # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# Google Cloud — Cloud Tasks & Document AI (Spec #10, #11)
# Leave blank for local dev — services fall back to thread-based simulation.
# ---------------------------------------------------------------------------
GCS_BUCKET_NAME=                                                        # [SECRET MANAGER] in prod: dwarikas-prod-media
GCP_PROJECT_ID=                                                         # [SECRET MANAGER] in prod
CLOUD_TASKS_QUEUE=dwarikas-task-queue                                   # [SECRET MANAGER] in prod
CLOUD_TASKS_REGION=asia-south1                                          # [SECRET MANAGER] in prod
DOCUMENT_AI_PROCESSOR_ID=                                               # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# Cloud Run self-reference (Cloud Tasks callback URL)
# ---------------------------------------------------------------------------
CLOUD_RUN_SERVICE_URL=http://localhost:8080                             # Cloud Run env var in prod

# ---------------------------------------------------------------------------
# CORS (Spec #02 / #25)
# Leave blank locally — all origins allowed via fallback.
# In production, set to comma-separated frontend origins.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=                                                   # [SECRET MANAGER] in prod: https://app.dwarikas.com,...

# ---------------------------------------------------------------------------
# External Partner API Gateway (Spec #15)
# ---------------------------------------------------------------------------
EXTERNAL_SIGNING_SECRET=local-dev-signing-secret-32chars               # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# WhatsApp Commerce Engine (Spec #14)
# ---------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=local-dev-verify-token                           # [SECRET MANAGER] in prod
WHATSAPP_API_TOKEN=                                                    # [SECRET MANAGER] in prod
WHATSAPP_PHONE_NUMBER_ID=                                              # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# Razorpay Payment Gateway (Spec #17)
# Use test keys (rzp_test_*) for local development.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx                                  # [SECRET MANAGER] in prod: rzp_live_*
RAZORPAY_KEY_SECRET=your-razorpay-test-secret                          # [SECRET MANAGER] in prod
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret                   # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# ONDC Seller Node (Spec #13)
# ---------------------------------------------------------------------------
ONDC_SUBSCRIBER_ID=dwarikas.com                                        # [SECRET MANAGER] in prod
ONDC_PRIVATE_KEY=                                                       # [SECRET MANAGER] in prod: base64 Ed25519 key

# ---------------------------------------------------------------------------
# Amazon SP-API (Spec #23)
# ---------------------------------------------------------------------------
AMAZON_LWA_CLIENT_ID=                                                  # [SECRET MANAGER] in prod
AMAZON_LWA_CLIENT_SECRET=                                              # [SECRET MANAGER] in prod
AMAZON_SELLER_ID=                                                       # [SECRET MANAGER] in prod
AMAZON_SQS_QUEUE_URL=                                                   # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# Quick Commerce — JioMart / Blinkit (Spec #24)
# ---------------------------------------------------------------------------
FYND_ACCESS_TOKEN=                                                      # [SECRET MANAGER] in prod
BLINKIT_VENDOR_ID=                                                      # [SECRET MANAGER] in prod
BLINKIT_WEBHOOK_SECRET=                                                 # [SECRET MANAGER] in prod

# ---------------------------------------------------------------------------
# Store Identity (Spec #18 — POS)
# ---------------------------------------------------------------------------
STORE_NAME=Dwarikas
STORE_GSTIN=27AAAAA0000A1Z5
STORE_ADDRESS=Mumbai, Maharashtra
